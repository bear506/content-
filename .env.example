# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ANTHROPIC_API_KEY: Optional. Required if you choose Anthropic Claude as your AI provider.
ANTHROPIC_API_KEY="MY_ANTHROPIC_API_KEY"

# CLAUDE_MODEL: Optional. Overrides which Claude model the Claude provider path calls.
# Defaults to "claude-sonnet-5" if unset. Only change this if Anthropic ships a newer
# model you want to switch to, or the current pin gets retired.
CLAUDE_MODEL="claude-sonnet-5"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Authentication (shared team login) ---

# AUTH_USERNAME: The single shared username required to log in.
AUTH_USERNAME="admin"

# AUTH_PASSWORD_HASH: A bcrypt hash of the shared password. Never put the
# plaintext password here. Generate a hash with:
#   npm run hash-password -- "your-password-here"
# and paste the resulting AUTH_PASSWORD_HASH line below.
AUTH_PASSWORD_HASH="$2a$12$REPLACE_WITH_GENERATED_HASH"

# SESSION_SECRET: Random secret used to sign session cookies. Use a long,
# random string (e.g. `openssl rand -hex 32`) and keep it private.
SESSION_SECRET="MY_RANDOM_SESSION_SECRET"

# --- Integrations (optional) ---

# NOTIFY_WEBHOOK_URL: Incoming webhook URL (Slack, Discord, Mattermost, etc.)
# that receives a { "text": "..." } POST whenever a campaign is generated or
# a post is approved. Leave unset to disable notifications entirely.
NOTIFY_WEBHOOK_URL=""
